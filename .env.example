# Salin ke .env lalu isi kredensial Neon Anda.
# Database nonaktif secara default; set DATABASE=true untuk menyimpan RSVP & ucapan.
DATABASE=false
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"

PORT=8080
TRUST_PROXY=0

# SMTP notifikasi RSVP & ucapan (default: Gmail).
# Gmail wajib memakai App Password (16 karakter), bukan password akun biasa:
# https://myaccount.google.com/apppasswords (aktifkan 2-Step Verification dulu).
# Email aktif hanya jika SMTP_HOST, MAIL_FROM (atau SMTP_USER), dan MAIL_TO terisi.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# false = STARTTLS (port 587), true = TLS langsung (port 465)
SMTP_SECURE=false
SMTP_USER=alamat@gmail.com
SMTP_PASS=app-password-16-karakter
MAIL_FROM="Wedding Alif & Indy <alamat@gmail.com>"
# Email pemilik yang menerima notifikasi
MAIL_TO=Alifkusuma188@gmail.com
